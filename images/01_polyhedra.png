        <table class="meta-table">
            <tr>
                <td>目标站点</td>
                <td>8000@fa78b44aae55432f</td>
            </tr>
            <tr>
                <td>目标路径</td>
                <td>/images/01_polyhedra.png</td>
            </tr>
            <tr>
                <td>请求时间</td>
                <td>2026-09-24 13:30:19 UTC</td>
            </tr>
        </table>
    </div>

    <div class="card-footer">
        <code>
            Request ID:
            <span onclick="prompt('此 Request ID 可复制给技术支持人员用于问题排查。', 'RL-75f89e8b2bb8b12098fb4b8d8d23993b')"
                  style="text-decoration: underline; cursor: pointer">
                RL-75f89e8b2bb8b12098fb4b8d8d23993b
